<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>BobinKumanda.App</RootNamespace>
    <AssemblyName>BobinKumanda</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\BobinKumanda.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fluent.Ribbon" Version="11.0.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\BobinKumanda.ico" />
    <Resource Include="Assets\logo-256.png" />
    <Resource Include="Assets\logo-wide.png" />
    <!-- Program yüklenirken hemen görünen açılış resmi; zayıf bilgisayarda ilk açılış birkaç saniye sürebilir -->
    <SplashScreen Include="Assets\splash.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BobinKumanda.Core\BobinKumanda.Core.csproj" />
  </ItemGroup>
</Project>
